    "dejection": {"neutral": 0.15, "floor": 0.0, "tau": 8},
    "irritability": {"neutral": 0.15, "floor": 0.0, "tau": 3}
  },
  "negative_dimensions": ["dejection", "irritability", "anxiety", "fear"],
  "silence": {
    "rules": {
      "longing": {"rate_per_hour": 0.04, "cap": 0.35, "gate_hours": 0},
      "anxiety": {"rate_per_hour": 0.02, "cap": 0.18, "gate_hours": 0},
      "seeking": {"rate_per_hour": 0.02, "cap": 0.12, "gate_hours": 0},
      "dejection": {"rate_per_hour": 0.01, "cap": 0.08, "gate_hours": 6}
    }
  },
  "proactive_sent_deltas": {"longing": -0.08, "seeking": -0.05, "anxiety": 0.03},
  "impact_scale": 2.0,
  "decision": {
    "increment": 0.1
  },
  "mood_follow_gain": {
    "min": 0.25,
    "max": 2.5,
    "factor": 4.0
  },
  "prompt": {
    "top_n": 5,
    "deviation_threshold": 0.08,
    "always_show": {"fear": 0.05},
    "level_high": 0.7,
    "level_elevated": 0.5
  },
  "affect": {
    "mood_follow_hours": 12.0,
    "mood_return_hours": 72.0
  },
  "proactive": {
    "triggers": [
      {"dimension": "fear", "threshold": 0.55, "reason": "fear"},
      {"dimension": "longing", "threshold": 0.48, "reason": "silence"}
    ]
  },
  "appraisal": {
    "min_similarity": 0.5,
    "fallback_label": "neutral",
    "prototypes": {
      "affectionate": {
        "text": "I love you and cherish spending time with you.",
