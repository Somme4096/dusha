        "deltas": {"protectiveness": 0.3, "anxiety": 0.12, "dejection": 0.12, "contentment": -0.08, "fatigue": 0.12}
      },
      "intimate_reference": {
        "text": "I wish I could hold you close and kiss you.",
        "deltas": {"lust": 0.18, "intimacy": 0.1}
