        "deltas": {"anxiety": -0.05, "longing": -0.04, "contentment": 0.03}
      },
      "hostile": {
        "text": "I hate you and want to insult and hurt you.",
        "deltas": {"dejection": 0.22, "anxiety": 0.18, "irritability": 0.12, "intimacy": -0.22, "contentment": -0.18}
      },
      "fear_separation": {
        "text": "I fear losing you, being abandoned, or never seeing you again.",
        "deltas": {"fear": 0.2, "longing": 0.15, "possessiveness": 0.12, "anxiety": 0.15, "protectiveness": 0.1, "dejection": 0.1, "irritability": 0.08}
