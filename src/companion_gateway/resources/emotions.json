{
  "schema_version": 3,
  "emotion_version": "0.4.0",
  "description": "Emotional definitions, change rules, and tuning for the companion state gateway. This file owns every dimension name. Code names none.",
  "value_range": {
    "min": 0.0,
    "max": 1.0
  },
  "dimensions": {
    "vitality": {"neutral": 0.5, "floor": 0.08, "tau": 6},
    "fatigue": {"neutral": 0.2, "floor": 0.02, "tau": 6},
    "longing": {"neutral": 0.3, "floor": 0.15, "tau": 6},
    "intimacy": {"neutral": 0.35, "floor": 0.06, "tau": 10},
    "possessiveness": {"neutral": 0.3, "floor": 0.05, "tau": 4},
    "lust": {"neutral": 0.3, "floor": 0.05, "tau": 4},
    "jealousy": {"neutral": 0.22, "floor": 0.0, "tau": 2},
    "anxiety": {"neutral": 0.2, "floor": 0.02, "tau": 5},
    "protectiveness": {"neutral": 0.25, "floor": 0.05, "tau": 4},
    "fear": {"neutral": 0.0, "floor": 0.0, "tau": 7},
    "contentment": {"neutral": 0.35, "floor": 0.06, "tau": 8},
    "elation": {"neutral": 0.2, "floor": 0.02, "tau": 3},
    "seeking": {"neutral": 0.25, "floor": 0.12, "tau": 4},
