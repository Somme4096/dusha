[Unit]
Description=Dusha for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%E/dusha/%i/environment
ExecStart=%h/.local/bin/dusha serve %i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
