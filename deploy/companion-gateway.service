[Unit]
Description=Companion state gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=COMPANION_GATEWAY_CONFIG=%h/.config/companion-gateway/config.yaml
EnvironmentFile=-%h/.config/companion-gateway/environment
ExecStart=%h/.local/bin/companion-gateway serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
